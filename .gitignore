# ---------- Secrets (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---------- Node / frontend ----------
node_modules/
dist/
npm-debug.log*

# ---------- Load test output (keep the folder, not the results) ----------
load-tests/results/*
!load-tests/results/.gitkeep

# ---------- Local Docker overrides ----------
docker-compose.override.yml

# ---------- Editors & OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
