# Copy to .env.local and adjust.

# Base path of the API. Keep it relative so NGINX (prod) or the Vite proxy (dev) handles routing.
VITE_API_BASE=/api/v1

# Where the Vite dev server forwards /api requests (your FastAPI instance or NGINX).
VITE_PROXY_TARGET=http://localhost:8000

# true = use the in-browser mock API (no backend needed). `npm run dev:mock` sets this for you.
VITE_USE_MOCK=false
